<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".IdentificationActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:weightSum="8"
        >

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:layout_marginBottom="-40dp"
            android:scaleType="centerCrop" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6"
            app:cardCornerRadius="40dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/identificationLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp">

                    <TextView
                        android:id="@+id/plantname_title"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="30dp"
                        android:text="Gewone Klaproos"
                        android:textStyle="bold"
                        android:paddingBottom="5dp"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/rarityTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Algemeen"
                        android:textAlignment="center"
                        android:textColor="@color/floro_bright_green"/>

                    <TextView
                        android:id="@+id/probabilityTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="zekerheid"
                        android:textAlignment="center" />

                    <View
                        android:id="@+id/view2"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginVertical="24dp"
                        android:background="@android:color/darker_gray" />

                    <TextView
                        android:lineSpacingExtra="4sp"
                        android:textSize="16sp"
                        android:id="@+id/wikiTextView"
                        android:text="Info niet beschikbaar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="100dp"
                        />


                </LinearLayout>

            </ScrollView>


        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="12dp"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/back"
            android:background="@android:color/transparent"/>
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>